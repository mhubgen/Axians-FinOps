{
  "swagger": "2.0",
  "info": {
    "title": "Azure Cost Management",
    "description": "Query Azure Cost Management for Power Platform PAYG (AI Builder / Copilot credits) and Azure AI Foundry model costs.",
    "version": "1.0"
  },
  "host": "management.azure.com",
  "basePath": "/",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "paths": {
    "/subscriptions/{subscriptionId}/providers/Microsoft.CostManagement/query": {
      "post": {
        "operationId": "QueryCost",
        "summary": "Query cost for a subscription",
        "description": "Runs an ActualCost query against the Cost Management API for the given subscription scope.",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "subscriptionId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Azure subscription ID (query scope)."
          },
          {
            "name": "api-version",
            "in": "query",
            "required": true,
            "type": "string",
            "default": "2023-11-01",
            "description": "Cost Management API version."
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/QueryDefinition" }
          }
        ],
        "responses": {
          "200": {
            "description": "Query result",
            "schema": { "$ref": "#/definitions/QueryResult" }
          }
        }
      }
    }
  },
  "definitions": {
    "QueryDefinition": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "default": "ActualCost" },
        "timeframe": { "type": "string" },
        "timePeriod": {
          "type": "object",
          "properties": {
            "from": { "type": "string" },
            "to": { "type": "string" }
          }
        },
        "dataset": {
          "type": "object",
          "properties": {
            "granularity": { "type": "string" },
            "aggregation": { "type": "object" },
            "grouping": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": { "type": "string" },
                  "name": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "QueryResult": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "properties": {
          "type": "object",
          "properties": {
            "nextLink": { "type": "string" },
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string" }
                }
              }
            },
            "rows": {
              "type": "array",
              "items": { "type": "array", "items": {} }
            }
          }
        }
      }
    }
  },
  "securityDefinitions": {
    "oauth2_auth": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
      "tokenUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
      "scopes": {
        "https://management.azure.com/user_impersonation": "Access Azure Service Management as organization users"
      }
    }
  },
  "security": [{ "oauth2_auth": ["https://management.azure.com/user_impersonation"] }]
}
